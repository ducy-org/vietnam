---
import Layout from "../layouts/Layout.astro";
import Slideshow from "../components/Slideshow.tsx";
import "../styles/global.css";
import slideshowsRaw from "../data/slideshows.json";

const MEDIA_URL = import.meta.env.PUBLIC_MEDIA_URL || '';
function m(path: string): string {
  if (!MEDIA_URL) return path;
  return MEDIA_URL + path.replace(/^\/media/, '');
}
const slideshows: any[] = (slideshowsRaw as any[]).map((show: any) => ({
  ...show,
  audio: show.audio ? m(show.audio) : show.audio,
  slides: show.slides?.map((s: any) => ({
    ...s,
    src: m(s.src),
    thumb: s.thumb ? m(s.thumb) : s.thumb,
  })),
}));
---

<Layout title="Mike's Slideshows — Letters Home" description="Narrated slideshows from Mike Ducy's 1968 deployment. Original slides synchronized with audio cassette narration recorded aboard USS Jouett.">
  <div class="ss-page">
    <div class="ss-page-header">
      <h1>Mike's Slideshows</h1>
      <p class="ss-page-intro">
        Mike Ducy shot 120 film slides throughout the deployment and recorded narration
        on cassette tape for the family back home. Press play to hear Mike describe
        each slide in his own words — the images advance automatically.
      </p>
    </div>

    {slideshows.map((show: any) => (
      <section class="ss-section" id={show.id}>
        <h2 class="ss-section-title">{show.title}</h2>
        <p class="ss-section-subtitle">{show.subtitle} &mdash; {show.date_label}</p>
        <Slideshow client:load show={show} />
      </section>
    ))}
  </div>
</Layout>
