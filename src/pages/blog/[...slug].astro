---
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(d: string): string {
  const dt = new Date(d + "T00:00:00");
  return dt.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
}
---

<Layout
  title={`${post.data.title} — Letters Home`}
  description={post.data.description}
  image={post.data.image}
  type="article"
  date={post.data.date}
>
  <main class="blog-post">
    <article>
      <header class="post-header">
        <h1>{post.data.title}</h1>
        <time datetime={post.data.date}>{formatDate(post.data.date)}</time>
      </header>
      <div class="post-body">
        <Content />
      </div>
      <footer class="post-footer">
        <a href="/blog">&larr; All posts</a>
      </footer>
    </article>
  </main>
</Layout>

<style is:global>
  .blog-post {
    max-width: 820px;
    margin: 0 auto;
    padding: 2rem 2.5rem 4rem;
  }
  .post-header {
    margin-bottom: 2.5rem;
    border-bottom: 2px solid var(--color-amber, #C4953A);
    padding-bottom: 1.5rem;
  }
  .post-header h1 {
    font-family: "Palatino Linotype", "Book Antiqua", Palatino, serif;
    color: var(--color-navy, #1B3A5C);
    font-size: 2rem;
    line-height: 1.25;
    margin: 0 0 0.5rem;
  }
  .post-header time {
    color: var(--color-olive, #4A5D3A);
    font-size: 0.9rem;
  }
  .post-body {
    font-family: "Palatino Linotype", "Book Antiqua", Palatino, serif;
    font-size: 1.1rem;
    line-height: 1.7;
    color: #333;
  }
  .post-body h2 {
    font-size: 1.5rem;
    color: var(--color-navy, #1B3A5C);
    margin: 3rem 0 1.25rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid #ddd;
  }
  .post-body p {
    margin: 0 0 1.25rem;
  }
  .post-body blockquote {
    border-left: 4px solid var(--color-amber, #C4953A);
    margin: 2rem 0;
    padding: 1.25rem 1.5rem;
    background: #ffffff;
    border-radius: 6px;
    font-style: italic;
    font-size: 0.95em;
    color: #3a3a3a;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.1);
  }
  .post-body blockquote p {
    margin: 0 0 0.75rem;
  }
  .post-body blockquote p:last-child {
    margin: 0;
  }
  .post-body .lb-grid {
    margin-bottom: 2rem;
  }
  .post-body a {
    color: var(--color-navy, #1B3A5C);
    text-decoration: underline;
    text-decoration-color: var(--color-amber, #C4953A);
    text-underline-offset: 2px;
  }
  .post-body a:hover {
    color: var(--color-amber, #C4953A);
  }
  .post-footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid #ddd;
  }
  .post-footer a {
    color: var(--color-navy, #1B3A5C);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .post-footer a:hover {
    color: var(--color-amber, #C4953A);
  }
  @media (max-width: 768px) {
    .blog-post {
      padding: 1.25rem 1rem 3rem;
    }
    .post-header {
      margin-bottom: 1.75rem;
      padding-bottom: 1rem;
    }
    .post-header h1 {
      font-size: 1.4rem;
      line-height: 1.3;
    }
    .post-header time {
      font-size: 0.85rem;
    }
    .post-body {
      font-size: 1rem;
      line-height: 1.65;
    }
    .post-body h2 {
      font-size: 1.25rem;
      margin: 2.25rem 0 1rem;
    }
    .post-body p {
      margin: 0 0 1.1rem;
    }
    .post-body blockquote {
      margin: 1.5rem 0;
      padding: 1rem 1.1rem;
      font-size: 0.93em;
    }
    .post-body blockquote p {
      margin: 0 0 0.6rem;
    }
    .post-footer {
      margin-top: 2rem;
    }
  }
</style>
