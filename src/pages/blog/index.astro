---
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

function formatDate(d: string): string {
  const dt = new Date(d + "T00:00:00");
  return dt.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
}
---

<Layout
  title="Blog — Letters Home"
  description="Stories from the archive: long-form narratives drawn from the primary sources of Mike Ducy's 1968 Vietnam deployment aboard USS Jouett (DLG-29)."
>
  <main class="blog-index">
    <h1>From the Archive</h1>
    <p class="blog-intro">
      Long-form stories drawn from the logbook, letters, tape recordings, and official records of the 1968 WestPac deployment.
    </p>
    <div class="blog-posts">
      {posts.map((post) => (
        <article class="blog-card">
          <a href={`/blog/${post.data.slug}`}>
            <h2>{post.data.title}</h2>
            <time datetime={post.data.date}>{formatDate(post.data.date)}</time>
            <p>{post.data.description}</p>
          </a>
        </article>
      ))}
    </div>
  </main>
</Layout>

<style>
  .blog-index {
    max-width: 820px;
    margin: 0 auto;
    padding: 2rem 2.5rem 4rem;
  }
  .blog-index h1 {
    font-family: "Palatino Linotype", "Book Antiqua", Palatino, serif;
    color: var(--color-navy, #1B3A5C);
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }
  .blog-intro {
    color: #666;
    margin-bottom: 2.5rem;
    font-size: 1.05rem;
    line-height: 1.6;
  }
  .blog-posts {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .blog-card {
    border: 1px solid #ddd;
    border-radius: 6px;
    overflow: hidden;
    transition: border-color 0.2s;
  }
  .blog-card:hover {
    border-color: var(--color-amber, #C4953A);
  }
  .blog-card a {
    display: block;
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
  }
  .blog-card h2 {
    font-family: "Palatino Linotype", "Book Antiqua", Palatino, serif;
    color: var(--color-navy, #1B3A5C);
    font-size: 1.35rem;
    margin: 0 0 0.5rem;
    line-height: 1.3;
  }
  .blog-card time {
    display: block;
    color: var(--color-olive, #4A5D3A);
    font-size: 0.85rem;
    margin-bottom: 0.75rem;
  }
  .blog-card p {
    color: #555;
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 0;
  }
  @media (max-width: 768px) {
    .blog-index {
      padding: 1.25rem 1rem 3rem;
    }
    .blog-index h1 {
      font-size: 1.5rem;
    }
    .blog-intro {
      font-size: 0.95rem;
      margin-bottom: 1.75rem;
    }
    .blog-card a {
      padding: 1.25rem;
    }
    .blog-card h2 {
      font-size: 1.15rem;
    }
    .blog-card p {
      font-size: 0.9rem;
    }
  }
</style>
