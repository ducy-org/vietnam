---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";

const MEDIA_URL = import.meta.env.PUBLIC_MEDIA_URL || '';
function m(path: string): string {
  if (!MEDIA_URL) return path;
  return MEDIA_URL + path.replace(/^\/media/, '');
}
---

<Layout>
  <div class="landing">
    <h1>Letters Home</h1>
    <p class="subtitle">A Sailor's Perspective of the Vietnam War in 1968</p>

    <div class="portraits">
      <div class="portrait">
        <img src={m("/media/photos/mike-ducy-dress-blues.jpg")} alt="FTG3 Michael F. Ducy, U.S. Navy" />
        <div class="portrait-name">FTG3 Michael F. Ducy, 20</div>
        <div class="portrait-branch">U.S. Navy</div>
      </div>
      <div class="portrait">
        <img src={m("/media/photos/bill-ducy-portrait.jpg")} alt="PFC William P. Ducy, U.S. Marine Corps" />
        <div class="portrait-name">PFC William P. Ducy, 19</div>
        <div class="portrait-branch">U.S. Marine Corps</div>
      </div>
    </div>

    <div class="intro">
      <p>
        In January 1968, two brothers from Decatur, Illinois were serving
        simultaneously in Vietnam. Mike Ducy sailed aboard USS Jouett (DLG-29),
        a guided missile frigate on search and rescue duty in the Tonkin Gulf.
        His younger brother Bill was a Marine, on the ground in Da Nang.
      </p>
      <p style="margin-top: 1rem;">
        They wrote letters home. They recorded tapes. Mike kept a daily logbook
        and shot Super 8 film. This site follows Mike's story day by day, from
        the ship's departure on January 16 through the homecoming on July 18
        &mdash; 187 days of war, mail call, MIG alerts, SAR rescues, and the
        constant thread of war & life.
      </p>
    </div>

    <h2 class="stats-heading">DLG-29 USS Jouett — WestPac 1968</h2>
    <div class="stats">
      <div class="stat">
        <div class="stat-number">187</div>
        <div class="stat-label">Days Deployed</div>
      </div>
      <div class="stat">
        <div class="stat-number">8</div>
        <div class="stat-label">Aviators Rescued</div>
      </div>
      <div class="stat">
        <div class="stat-number">98</div>
        <div class="stat-label">Days on SAR Station</div>
      </div>
      <div class="stat">
        <div class="stat-number">1</div>
        <div class="stat-label">Medal of Honor</div>
        <div class="stat-note">LTJG Clyde Lassen, HC-7 — 19 Jun '68</div>
      </div>
    </div>

    <a href="/map" class="cta">Enter the Interactive Journey &rarr;</a>
  </div>
</Layout>
