---
import PeopleXray from "../components/PeopleXray.tsx";
import people from "../data/people.json";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
}

const siteName = "Letters Home";
const defaultDescription = "An interactive documentary following two brothers through the Vietnam War, 1968. Mike Ducy aboard USS Jouett (DLG-29) and Bill Ducy with the Marines in Da Nang.";
const defaultImage = "/og-image.jpg";

const {
  title = "Letters Home — A Sailor's Perspective of the Vietnam War in 1968",
  description = defaultDescription,
  image = defaultImage,
  type = "website",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL.href} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL.href} />
    <meta property="og:site_name" content={siteName} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL.href} />

    <!-- Structured Data -->
    {type === "website" ? (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": siteName,
        "url": Astro.site?.href,
        "description": description,
        "publisher": {
          "@type": "Organization",
          "name": "Ducy Family Archives",
        },
      })} />
    ) : (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": title,
        "description": description,
        "url": canonicalURL.href,
        "image": ogImageURL.href,
        "publisher": {
          "@type": "Organization",
          "name": "Ducy Family Archives",
        },
        "isPartOf": {
          "@type": "WebSite",
          "name": siteName,
          "url": Astro.site?.href,
        },
      })} />
    )}

    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-DZ1NZ4BJKC"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-DZ1NZ4BJKC');
      document.addEventListener('play', function(e) {
        var el = e.target;
        if (!el || !el.tagName) return;
        var tag = el.tagName.toLowerCase();
        if (tag === 'audio') {
          var src = el.querySelector('source');
          gtag('event', 'audio_play', { event_category: 'media', event_label: (src && src.src) || el.src || '' });
        } else if (tag === 'video') {
          var vsrc = el.querySelector('source');
          gtag('event', 'video_play', { event_category: 'media', event_label: el.src || (vsrc && vsrc.src) || '' });
        }
      }, true);
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="header-left">
        <a href="/" class="site-title">Letters Home</a>
        <span class="site-subtitle">A Sailor's Perspective of the Vietnam War in 1968</span>
      </div>
      <nav class="header-nav">
        <a href="/map" class="nav-link">Map</a>
        <a href="/day/1968-01-16" class="nav-link">Timeline</a>
        <a href="/slideshow" class="nav-link">Slideshows</a>
        <a href="/cruisebook" class="nav-link">1968 Cruise Book</a>
        <a href="/archive" class="nav-link">Archive</a>
        <a href="/about" class="nav-link">About</a>
        <PeopleXray people={people} client:load />
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <p>&copy; 2026 Ducy Family Archives. From the personal archives of FTG3 Michael F. Ducy, USN. Digitized and curated by Michael Ducy II.</p>
    </footer>
  </body>
</html>
